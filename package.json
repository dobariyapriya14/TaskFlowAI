{
  "name": "TaskFlowAI",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:build-ios": "detox build --configuration ios.sim.debug",
    "e2e:test-ios": "detox test --configuration ios.sim.debug",
    "e2e:build-android": "detox build --configuration android.emu.debug",
    "e2e:test-android": "detox test --configuration android.emu.debug",
    "e2e:test-android-attached": "detox test --configuration android.attached.debug",
    "prepare": "husky"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@react-native-firebase/analytics": "^26.0.0",
    "@react-native-firebase/app": "^26.0.0",
    "@react-native-firebase/auth": "^26.0.0",
    "@react-native-firebase/crashlytics": "^26.0.0",
    "@react-native-firebase/firestore": "^26.0.0",
    "@react-native-firebase/perf": "^26.0.0",
    "@react-native/new-app-screen": "0.86.2",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@shopify/flash-list": "^2.3.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.3.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
